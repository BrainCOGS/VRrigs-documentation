# Ignore runtime and log files
pids
logs
npm-debug.log

# Ignore Node.js modules
node_modules

# Ignore test coverage and other temporary data
coverage/
run
.nyc_output
.basement
basement_dist

# Ignore system-specific files
.DS_Store

# Ignore VitePress cache and build output
.vitepress/cache
.vitepress/dist

# Ignore configuration files specific to local development
config.local.js

# pnpm is the package manager; keep other lockfiles out
yarn.lock
package-lock.json
yarn-error.log
