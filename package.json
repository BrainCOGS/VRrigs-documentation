{
  "name": "vrrigs",
  "version": "0.0.1",
  "description": "Documentation for virtual reality rigs at Princeton BRAIN CoGS project",
  "main": "index.js",
  "authors": {
    "name": "Juan Lopez Luna",
    "email": "juanlopez@princeton.edu"
  },
  "repository": "/VR_rigs_docs",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "clean": "rm -rf .vitepress/cache .vitepress/dist node_modules",
    "dev": "vitepress dev --port 8080",
    "build": "vitepress build",
    "preview": "vitepress preview --port 8080",
    "test": "pnpm run build && pnpm run test:dist",
    "test:dist": "pnpm run test:css-bom && pnpm run test:links && pnpm run test:visual-homepage",
    "test:css-bom": "node .vitepress/scripts/test-css-bom.js",
    "test:links": "node .vitepress/scripts/test-links.js",
    "test:visual-homepage": "node .vitepress/scripts/test-visual-homepage.js",
    "audit": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@mdit/plugin-figure": "~1.1.1",
    "playwright": "^1.63.0",
    "vitepress": "^2.0.0-alpha.20"
  }
}
